{
  "name": "@0gflow/explorer-api",
  "version": "1.0.2",
  "description": "Read-only HTTP API over an indexed 0G Flow database.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "serve": "tsx src/cli.ts"
  },
  "dependencies": {
    "@0gflow/config": "workspace:*",
    "@0gflow/core": "workspace:*",
    "@0gflow/indexer": "workspace:*",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "license": "MIT",
  "keywords": [
    "0g",
    "0g-labs",
    "galileo",
    "ai-agents",
    "agent-marketplace",
    "verifiable",
    "erc-8004",
    "blockchain"
  ],
  "homepage": "https://explorer-production-25c8.up.railway.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryan/0g-flow.git",
    "directory": "packages/explorer-api"
  },
  "bugs": {
    "url": "https://github.com/aryan/0g-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "0gflow-explorer-api": "./dist/cli.js"
  }
}
