{
  "name": "@0gflow/publish",
  "version": "1.0.3",
  "description": "Publish an agent to the 0G Flow marketplace: mint an identity, prove conformance, list it on chain.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "0gflow-publish": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./calldata": {
      "types": "./dist/calldata.d.ts",
      "default": "./dist/calldata.js"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@0gflow/config": "workspace:*",
    "@0gflow/conform": "workspace:*",
    "@0gflow/core": "workspace:*",
    "@0gflow/storage": "workspace:*",
    "viem": "^2.21.0"
  },
  "license": "MIT",
  "keywords": [
    "0g",
    "0g-labs",
    "galileo",
    "ai-agents",
    "agent-marketplace",
    "verifiable",
    "erc-8004",
    "blockchain"
  ],
  "homepage": "https://explorer-production-25c8.up.railway.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCARPxVeNOM/4RGE.git",
    "directory": "packages/publish"
  },
  "bugs": {
    "url": "https://github.com/SCARPxVeNOM/4RGE/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
