{
  "name": "@0gflow/verify",
  "version": "1.0.2",
  "description": "Independently verify a 0G Flow run from public chain data. Single file, zero dependencies.",
  "type": "module",
  "bin": {
    "0gflow-verify": "./dist/verify.mjs"
  },
  "main": "./dist/verify.mjs",
  "files": [
    "README.md",
    "dist",
    "dist-tsc"
  ],
  "scripts": {
    "build": "node scripts/bundle.mjs"
  },
  "dependencies": {},
  "license": "MIT",
  "devDependencies": {
    "@0gflow/core": "workspace:*",
    "@0gflow/config": "workspace:*",
    "esbuild": "^0.21.5",
    "viem": "^2.21.55"
  },
  "exports": {
    ".": {
      "types": "./dist-tsc/index.d.ts",
      "default": "./dist/verify.mjs"
    },
    "./decode": {
      "types": "./dist-tsc/decode.d.ts",
      "default": "./dist-tsc/decode.js"
    },
    "./sources": {
      "types": "./dist-tsc/sources.d.ts",
      "default": "./dist-tsc/sources.js"
    },
    "./verify": {
      "types": "./dist-tsc/verify.d.ts",
      "default": "./dist-tsc/verify.js"
    }
  },
  "keywords": [
    "0g",
    "0g-labs",
    "galileo",
    "ai-agents",
    "agent-marketplace",
    "verifiable",
    "erc-8004",
    "blockchain"
  ],
  "homepage": "https://explorer-production-25c8.up.railway.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryan/0g-flow.git",
    "directory": "packages/verify"
  },
  "bugs": {
    "url": "https://github.com/aryan/0g-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
