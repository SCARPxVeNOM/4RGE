{
  "name": "@0gflow/indexer",
  "version": "1.0.0",
  "description": "Index 0G Flow receipts, listings and bonds from 0G Chain into Postgres.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "index": "tsx src/cli.ts"
  },
  "dependencies": {
    "@0gflow/config": "workspace:*",
    "@0gflow/core": "workspace:*",
    "@0gflow/verify": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  },
  "license": "MIT",
  "keywords": [
    "0g",
    "0g-labs",
    "galileo",
    "ai-agents",
    "agent-marketplace",
    "verifiable",
    "erc-8004",
    "blockchain"
  ],
  "homepage": "https://explorer-production-25c8.up.railway.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryan/0g-flow.git",
    "directory": "packages/indexer"
  },
  "bugs": {
    "url": "https://github.com/aryan/0g-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
