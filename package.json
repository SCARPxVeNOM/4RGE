{
  "name": "0g-flow",
  "private": true,
  "version": "1.0.0",
  "description": "Verifiable agent workflows on 0G",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @0gflow/verify build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force && tsc --noEmit -p apps/explorer",
    "test:contracts": "forge test --root contracts",
    "test:python": "python -m pytest packages/python-sdk/tests -q"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
